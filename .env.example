# --- Server ---
PORT=5100
NODE_ENV=development
# MongoDB connection (local, Docker or Atlas). For a quick try without MongoDB run `npm run dev:memory`.
MONGO_URI=mongodb://127.0.0.1:27017/sevai
# Long random string. REQUIRED in production.
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
CUSTOMER_TOKEN_TTL=30d
STAFF_TOKEN_TTL=12h
# Comma-separated list of allowed browser origins (client web app + admin panel)
CORS_ORIGIN=http://localhost:5273,http://localhost:5274
# Seed demo catalogue/cities/professionals when the database is empty (defaults to true outside production)
SEED_ON_BOOT=true
# First admin account created by the seed
ADMIN_EMAIL=admin@sevai.in
ADMIN_PASSWORD=Admin@12345
# Slot times are shown in this offset from UTC (330 = India Standard Time)
TZ_OFFSET_MINUTES=330
